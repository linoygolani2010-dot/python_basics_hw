def count_elements_in_tuples(list_tuples):
    dic ={}
    for t in list_tuples:
        for element in t:
            if element in dic:
                dic[element] += 1
            else:
                dic[element] = 1
    return dic

list = [(1, 2), (3, 4), (1, 5), (2, 3)]
print(count_elements_in_tuples(list))